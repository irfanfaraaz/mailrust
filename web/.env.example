ENGINE_URL=http://localhost:8080
# Same value as the engine's WEB_SECRET (32+ chars)
# WEB_SECRET=
# Production only: set to false when the dashboard is served over plain http (the session cookie is Secure otherwise)
# COOKIE_SECURE=false

# Show the public front page at / to visitors who are not logged in. Only for the project's own site; self-hosted copies leave this off.
# MAILRUST_LANDING=true
