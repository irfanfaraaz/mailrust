{
  "db_name": "PostgreSQL",
  "query": "SELECT k.id AS key_id, k.account_id, k.access AS \"access: KeyAccess\",\n                  a.status AS \"account_status: AccountStatus\", a.paused_reason\n           FROM api_keys k JOIN accounts a ON a.id = k.account_id\n           WHERE k.key_hash = $1 AND k.revoked_at IS NULL",
