  "db_name": "PostgreSQL",
  "query": "SELECT id, from_address, to_addresses, subject, status AS \"status: EmailStatus\", send_at, created_at\n           FROM emails\n           WHERE account_id = $1 AND ($2::email_status IS NULL OR status = $2) AND ($3::uuid IS NULL OR id < $3)\n           ORDER BY id DESC LIMIT $4",
