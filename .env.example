DATABASE_URL=postgres://mailrust:mailrust@localhost:5432/mailrust
# Production (deploy/docker-compose.prod.yml) only: set a long random password.
# POSTGRES_PASSWORD=change-me
PUBLIC_URL=http://localhost:8080
# Dashboard (web/) — login and invite links point here
WEB_URL=http://localhost:3000
# Account + address that send login and invite emails (domain must be verified)
# SYSTEM_ACCOUNT_ID=
# SYSTEM_FROM=Mailrust <login@mail.example.com>
# Shared with web/ so the engine can trust the client IP it passes (32+ chars)
# WEB_SECRET=
# Dev only: print login and invite links to the log
DEV_LOG_LINKS=true
BIND_ADDR=0.0.0.0:8080
TRACKING_SECRET=change-me-to-a-random-string-of-at-least-32-chars
MAILRUST_SENDER=fake
OUTBOX_DIR=./outbox
RUST_LOG=info,sqlx=warn
# RUST_LOG_FORMAT=json
# SES_MAX_SEND_RATE=14
# WORKER_PROCESSES=1
# Emails one worker claims per round, and sends at the same time
# WORKER_BATCH=50
# WORKER_CONCURRENCY=10
# MAILRUST_ALLOW_HTTP_WEBHOOKS=false   # true = allow http:// and private-network webhook targets (local testing only)
# --- only when MAILRUST_SENDER=ses ---
# AWS_REGION=us-east-1
# SES_CONFIGURATION_SET=mailrust
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:mailrust-events
